# Evironn environment contract. Never commit real values.

# Neon Postgres: pooled runtime URL and direct migration/seed URL.
POSTGRES_URL="postgresql://user:pass@ep-example-pooler.eu-central-1.aws.neon.tech/evironn?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:pass@ep-example.eu-central-1.aws.neon.tech/evironn?sslmode=require"
NEON_FETCH_TIMEOUT_MS="15000"

# Public application URLs.
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js.
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local seed administrator. Do not use shared credentials.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Email delivery.
RESEND_API_KEY=""
EMAIL_FROM_TRANSACTIONAL="Evironn <orders@example.com>"
EMAIL_FROM_NEWSLETTER="Evironn <hello@example.com>"

# YooKassa sandbox.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_MODE="sandbox"

# DaData address autocomplete.
DADATA_TOKEN=""

# Cloudinary. Phase 5 restricts operations to the Evironn folder allowlist.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Upstash Redis. Vercel Marketplace may provide KV_* aliases.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Sentry.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_RELEASE=""

# Demo and operations. Keep false outside the dedicated public demo deployment.
# Vercel Production only: set DEMO_MODE=true and provide CRON_SECRET.
NEXT_PUBLIC_DEMO_MODE="false"
DEMO_MODE="false"
CRON_SECRET=""
SMOKE_BASE_URL=""

# Test-only verification bypass; never set in production.
E2E_TEST_CODE=""

# Disposable database only: Playwright requires an explicit pooled URL and write opt-in.
# The direct/unpooled URL is optional; never point these at local, Preview, staging, or Production databases.
E2E_DATABASE_URL=""
E2E_DATABASE_URL_UNPOOLED=""
E2E_DATABASE_ALLOW_WRITES=""
