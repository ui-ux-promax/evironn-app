{
  "name": "evironn-storefront",
  "version": "0.0.0",
  "description": "Evironn storefront baseline",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "vite",
    "build": "vite build",
    "check:repository": "node scripts/check-repository.mjs",
    "gate": "npm run format:check && npm run check:repository && npm run lint && npm run typecheck && npm run test",
    "gate:full": "npm run gate && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.27.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  }
}
